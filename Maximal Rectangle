class Solution {
    public int maximalRectangle(char[][] mat) {
        int matrix[][]=new int[mat.length][mat[0].length];
        for(int i=0;i<matrix.length;i++){
            for(int j=0;j<mat[0].length;j++){
                matrix[i][j]=mat[i][j]-'0';
            }
        }
        for(int i=1;i<matrix.length;i++){
            for(int j=0;j<matrix[0].length;j++){  //prefix sum
                if(matrix[i][j]==1 ){
                    matrix[i][j]=matrix[i-1][j]+1;
                }
            }
        }
        int max=0;
        for(int j=0;j<matrix.length;j++){  //in this we are treating each row as a different ques of max histogram itself 
            int maxArea=0; 
            Stack<Integer> stack=new Stack<>();
            for(int i=0;i<matrix[0].length;i++){
                while(!stack.isEmpty() && matrix[j][stack.peek()]>matrix[j][i]){
                    int element=stack.pop();
                    int nse=i;
                    int pse=stack.isEmpty()? -1:stack.peek();
                    maxArea=Math.max(maxArea,matrix[j][element]*(nse-pse-1));
                }
                stack.push(i);
            }
            while(!stack.isEmpty()){
                int nse=matrix[0].length;
                int element=stack.pop();
                int pse=stack.isEmpty()? -1:stack.peek();
                maxArea=Math.max(maxArea,matrix[j][element]*(nse-pse-1));
            }
            max=Math.max(max,maxArea);
        }
        return max;
    }
}