//i done it without stack 

//in brute force we have to take 2 list of i know and known by in this if i know 0 and known by n-1 then i am a celebrity 
//but in optimal we can do it in single pass using 2 pointer approach

//optimal bytwo pointer
class Solution {
    public int celebrity(int mat[][]) {
        // code here
        int top=0;
        int down=mat.length-1;
        while(top<down){
            if(mat[top][down]==1){
                top++;
            }
            else {
               down--;
            }
            
        }
        int candidate = top;

        for (int i = 0; i < mat.length; i++) {
            if (i != candidate) {
                if (mat[candidate][i] == 1 || mat[i][candidate] == 0) {  //means if anybody don not know top or top know anybody then no celebrity found here
                //this while loop only remove when top and down are equal and we will check if top is possile or not else no celebrity found
                    return -1; 
                }
            }
        }

        return top;
    }
}