class Solution {
    class Pair{
        int val;
        int idx;
        Pair(int val,int idx){
            this.val=val;
            this.idx=idx;
        }
    }
    public int timeRequiredToBuy(int[] tickets, int k) {
        Queue<Pair> q=new LinkedList<>();
        for(int i=0;i<tickets.length;i++){
            q.add(new Pair(tickets[i],i));
        }
        int t=1;
        while(!q.isEmpty()){
            Pair p=q.remove();
            if(p.val-1==0){
                if(p.idx==k){
                    return t;
                }
                //t++;
            }
            else{
                q.add(new Pair(p.val-1,p.idx));
               // t++;
            }
            t++;
        }
        return t;

    }
}