class Solution {
    static ArrayList<Integer> nextSmallerEle(int[] arr) {
        // code here
        int n=arr.length;
        Stack<Integer> st=new Stack<>();
        ArrayList<Integer> nse=new ArrayList<>();
        for(int i=n-1;i>=0;i--){
            while(!st.isEmpty() && arr[st.peek()]>=arr[i]){
                st.pop();
            }
            nse.add(st.isEmpty()?-1:arr[st.peek()]);
            st.push(i);
        }
        Collections.reverse(nse);
        return nse;
        
    }
}