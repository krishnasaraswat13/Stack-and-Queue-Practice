class Solution {
    public long subArrayRanges(int[] arr) {
        int n=arr.length;
        Stack<Integer> st=new Stack<>();
        ArrayList<Integer> pse=new ArrayList<>();
        for(int i=0;i<n;i++){
            while(!st.isEmpty() && arr[st.peek()]>arr[i]){
                st.pop();
            }
            pse.add(st.isEmpty()?-1:st.peek());
            st.push(i);
        }
        while(!st.isEmpty()){
            st.pop();
        }
        ArrayList<Integer> nse=new ArrayList<>();
        for(int i=n-1;i>=0;i--){
            while(!st.isEmpty() && arr[st.peek()]>=arr[i]){
                st.pop();
            }
            nse.add(st.isEmpty()?n:st.peek());
            st.push(i);
        }
        Collections.reverse(nse);
        while(!st.isEmpty()){
            st.pop();
        }
        ArrayList<Integer> pge=new ArrayList<>();
        for(int i=0;i<n;i++){
            while(!st.isEmpty() && arr[st.peek()]<arr[i]){
                st.pop();
            }
            pge.add(st.isEmpty()?-1:st.peek());
            st.push(i);
        }
        while(!st.isEmpty()){
            st.pop();
        }
        ArrayList<Integer> nge=new ArrayList<>();
        for(int i=n-1;i>=0;i--){
            while(!st.isEmpty() && arr[st.peek()]<=arr[i]){
                st.pop();
            }
            nge.add(st.isEmpty()?n:st.peek());
            st.push(i);
        }
        Collections.reverse(nge);

        long ans = 0;
        for (int i = 0; i < n; i++) {
            long curr=0;
            int left=i-pse.get(i);
            int right=nse.get(i)-i;
            int lleft=i-pge.get(i);
            int lright=nge.get(i)-i;
             curr=((long) arr[i] * lleft * lright) - ((long)arr[i] * left * right);
             ans+=curr;
        }

        return ans; 
    }
}